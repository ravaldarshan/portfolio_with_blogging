<FilesMatch "^\.env$">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "(\.env|\.git|\.svn|\.htaccess|\.htpasswd|composer\.json|composer\.lock|artisan)">
  Order allow,deny
  Deny from all
</FilesMatch>

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/public
  RewriteCond %{REQUEST_URI} ^/phpmyadmin/ [NC]
  RewriteRule ^ - [L]
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
